#!/usr/bin/env bash
# Hardened: 0600 output via umask, request timeouts, URL-encoded hostname.
# Works against both http:// and https:// ingest URLs — TLS is verified by
# curl's default behaviour when the scheme is https.
set -uo pipefail
umask 077

OUTPUT_FILE='{{ output_file_linux }}'
API_BASE='{{ api_base_url }}'

HOSTNAME_VAL="$(hostname)"

# RFC 3986 unreserved-only encoder. Hostnames are ASCII per RFC 1123 so a
# byte-wise loop is sufficient; this is defence-in-depth against an unusual
# hostname injecting query parameters into the upload URL.
# `{% raw %}` shields `${#s}` from Jinja, which would otherwise read `{#`
# as a Jinja comment opener.
{% raw %}
urlencode() {
    local s="$1" i ch out=""
    for (( i = 0; i < ${#s}; i++ )); do
        ch="${s:i:1}"
        case "$ch" in
            [a-zA-Z0-9.~_-]) out+="$ch" ;;
            *) out+=$(printf '%%%02X' "'$ch") ;;
        esac
    done
    printf '%s' "$out"
}
{% endraw %}

HOSTNAME_ENC="$(urlencode "$HOSTNAME_VAL")"
API_URL="${API_BASE}/api/ingest/patches/linux?hostname=${HOSTNAME_ENC}"

{
    echo "=== Hostname ==="
    echo "${HOSTNAME_VAL}"
    echo
    echo "=== OS Information ==="
    if [[ -r /etc/os-release ]]; then
        cat /etc/os-release
    else
        uname -a
    fi
    echo
    echo "=== Available Patches ==="
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -qq >/dev/null 2>&1 || true
        apt-get -s upgrade 2>/dev/null || true
    elif command -v dnf >/dev/null 2>&1; then
        # dnf check-update exits 100 when updates are available
        dnf check-update || true
    elif command -v yum >/dev/null 2>&1; then
        # yum check-update exits 100 when updates are available
        yum check-update || true
    else
        echo "No supported package manager found"
    fi
} > "${OUTPUT_FILE}"

curl -sS \
    --connect-timeout 10 \
    --max-time 60 \
    --fail-with-body \
    -X POST \
    "${API_URL}" \
    -H "Content-Type: text/plain" \
    --data-binary "@${OUTPUT_FILE}"
